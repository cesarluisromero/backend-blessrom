# Copy to /opt/blessrom/backend.env on the VPS, chmod 600.
# Compose reads this file in raw format: DO NOT quote passwords or escape $.
DB_URL=jdbc:postgresql://blessrom-db:5432/blessrom
DB_USER=blessrom_app
DB_PASSWORD=REEMPLAZAR_EN_EL_VPS
# The realm must exist. Use the actual Keycloak URL reachable from the container.
# Do not change the hostname/realm of the existing Facebook application.
OIDC_AUTH_SERVER_URL=REEMPLAZAR_CON_URL_REAL_DEL_REALM_BLESSROM
QUARKUS_DATASOURCE_JDBC_MAX_SIZE=5
QUARKUS_DATASOURCE_JDBC_LOGIN_TIMEOUT=15S
# Enable only after entering valid SMTP credentials.
NOTIFICATIONS_ENABLED=false
SMTP_FROM=no-reply@blessrom.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=REEMPLAZAR_EN_EL_VPS
SMTP_PASSWORD=REEMPLAZAR_EN_EL_VPS
SMTP_START_TLS=REQUIRED
# Cloudflare R2. Keep these credentials only on the VPS.
R2_ENABLED=false
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=blessrom-media-production
R2_ACCESS_KEY_ID=REEMPLAZAR_EN_EL_VPS
R2_SECRET_ACCESS_KEY=REEMPLAZAR_EN_EL_VPS
MEDIA_PUBLIC_BASE_URL=https://media.blessrom.com
R2_UPLOAD_EXPIRY_SECONDS=600
# Estudio IA. Mantener deshabilitado hasta desplegar el perfil compose "ai".
AI_STUDIO_ENABLED=false
AI_WORKER_URL=http://ai-image-worker:8090
AI_WORKER_TOKEN=REEMPLAZAR_CON_TOKEN_LARGO_ALEATORIO
OPENAI_API_KEY=REEMPLAZAR_EN_EL_VPS
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_GHOST_QUALITY=high
OPENAI_TEXT_MODEL=gpt-5-mini
