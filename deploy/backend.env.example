# Copy to /opt/blessrom/backend.env on the VPS, chmod 600.
# Compose reads this file in raw format: DO NOT quote passwords or escape $.
DB_URL=jdbc:postgresql://blessrom-db:5432/blessrom
DB_USER=blessrom_app
DB_PASSWORD=REEMPLAZAR_EN_EL_VPS
# The realm must exist. Use the actual Keycloak URL reachable from the container.
# Do not change the hostname/realm of the existing Facebook application.
OIDC_AUTH_SERVER_URL=REEMPLAZAR_CON_URL_REAL_DEL_REALM_BLESSROM
QUARKUS_DATASOURCE_JDBC_MAX_SIZE=5
QUARKUS_DATASOURCE_JDBC_LOGIN_TIMEOUT=15S
# Enable only after entering valid SMTP credentials.
NOTIFICATIONS_ENABLED=false
SMTP_FROM=no-reply@blessrom.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=REEMPLAZAR_EN_EL_VPS
SMTP_PASSWORD=REEMPLAZAR_EN_EL_VPS
SMTP_START_TLS=REQUIRED
